{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "allow-open-workspace",
    "allow-list-tree",
    "allow-read-file",
    "allow-write-file",
    "allow-set-api-key",
    "allow-has-api-key",
    "allow-upsert-agent",
    "allow-send-prompt",
    "allow-cancel-turn",
    "allow-answer-permission",
    "allow-mods-heartbeat",
    "allow-mods-list",
    "allow-mods-install",
    "allow-mods-dev-load",
    "allow-mods-uninstall",
    "allow-mods-set-enabled",
    "allow-mod-storage-get",
    "allow-mod-storage-set"
  ]
}
